{
  "version": 2,
  "cleanUrls": true,
  "routes": [
    {
      "src": "/room",
      "dest": "/public/room.html"
    },
    {
      "src": "/room.html",
      "dest": "/public/room.html"
    },
    {
      "src": "/",
      "dest": "/public/index.html"
    },
    {
      "src": "/css/(.*)",
      "dest": "/public/css/$1"
    },
    {
      "src": "/js/(.*)",
      "dest": "/public/js/$1"
    },
    {
      "src": "/images/(.*)",
      "dest": "/public/images/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/public/$1"
    }
  ]
}
